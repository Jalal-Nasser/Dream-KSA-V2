/**
 * app/src/db/mic.ts (shim)
 * Re-exports a canonical implementation if found at common candidate locations.
 * Falls back to no-op stubs that log warnings if no real implementation is available.
 *
 * This file intentionally uses only static require() calls (no dynamic require(variable)),
 * so Metro bundler will accept it.
 */

(() => {
  // candidate paths (order matters) - static strings only
  const candidates = [
    // project-root canonical implementations we commonly use
    '../../src/db/mic',        // from app/src/db => project-root/src/db/mic
    '../../db/mic',            // alternative
    '../../../src/db/mic',     // other possible relative placements
    '../../../lib/db/mic',     // lib path
    '../../db/mic_impl',       // alternate names
    './mic_impl',              // local implementation folder
    './mic',                   // friendlier fallback
  ];

  for (const p of candidates) {
    try {
      // eslint-disable-next-line @typescript-eslint/no-var-requires, global-require
      const impl = require(p);
      // if found, re-export everything and exit
      module.exports = impl;
      exports.default = impl.default || impl;
      Object.keys(impl).forEach(k => { if (k !== 'default') exports[k] = impl[k]; });
      // indicate success via comment (no runtime effect)
      return;
    } catch (e) {
      // ignore: try the next static candidate
    }
  }

  // No implementation found: provide safe stubs so the app bundles and runs.
  // These log helpful warnings so you can spot missing impl at runtime.
  // eslint-disable-next-line no-console
  console.warn('[mic shim] no real implementation found for src/db/mic - using fallback stubs.');

  const raiseHand = async (userId, roomId) => {
    // eslint-disable-next-line no-console
    console.warn('[mic.stub] raiseHand called but real implementation missing', { userId, roomId });
    return { ok: false, error: 'not_implemented' };
  };

  const cancelHand = async (userId, roomId) => {
    // eslint-disable-next-line no-console
    console.warn('[mic.stub] cancelHand called but real implementation missing', { userId, roomId });
    return { ok: false, error: 'not_implemented' };
  };

  const grantMic = async (adminId, userId, roomId) => {
    // eslint-disable-next-line no-console
    console.warn('[mic.stub] grantMic called but real implementation missing', { adminId, userId, roomId });
    return { ok: false, error: 'not_implemented' };
  };

  const revokeMic = async (adminId, userId, roomId) => {
    // eslint-disable-next-line no-console
    console.warn('[mic.stub] revokeMic called but real implementation missing', { adminId, userId, roomId });
    return { ok: false, error: 'not_implemented' };
  };

  const listenRoom = (roomId, onChange) => {
    // eslint-disable-next-line no-console
    console.warn('[mic.stub] listenRoom called but real implementation missing', { roomId });
    return () => {};
  };

  module.exports = {
    raiseHand,
    cancelHand,
    grantMic,
    revokeMic,
    listenRoom,
  };
  exports.default = module.exports;
})();